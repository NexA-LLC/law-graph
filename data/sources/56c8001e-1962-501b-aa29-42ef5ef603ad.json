      {
        "tag": "ArticleCaption",
        "attr": {},
        "children": [
          "（国土交通省令で定める学科）"
        ]
      },
      {
        "tag": "ArticleTitle",
        "attr": {},
        "children": [
          "第一条"
        ]
      },
      {
