                    "attr": {
                      "Num": "1",
                      "WritingMode": "vertical"
                    },
                    "children": [
                      "請負代金の額"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "tag": "Item",
            "attr": {
              "Num": "3"
            },
            "children": [
              {
                "tag": "ItemTitle",
                "attr": {},
                "children": [
                  "三"
                ]
              },
              {
                "tag": "ItemSentence",
                "attr": {},
                "children": [
                  {
                    "tag": "Sentence",
                    "attr": {
                      "Num": "1",
                      "WritingMode": "vertical"
                    },
                    "children": [
                      "工事着手の時期及び工事完成の時期"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "tag": "Item",
            "attr": {
              "Num": "4"
            },
            "children": [
              {
                "tag": "ItemTitle",
                "attr": {},
                "children": [
                  "四"
