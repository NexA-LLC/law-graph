                  {
                    "tag": "Sentence",
                    "attr": {
                      "Num": "1",
                      "WritingMode": "vertical"
                    },
                    "children": [
                      "前号に掲げるもののほか、特定の個人情報を容易に検索することができるように体系的に構成したものとして政令で定めるもの"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
