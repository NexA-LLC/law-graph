                "children": [
                  {
                    "tag": "Sentence",
                    "attr": {
                      "Num": "1",
                      "WritingMode": "vertical"
                    },
                    "children": [
                      "特定の個人情報を電子計算機を用いて検索することができるように体系的に構成したもの"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "tag": "Item",
            "attr": {
              "Num": "2"
            },
            "children": [
              {
