  "anchors": [
    {
      "id": "a75e3d79-d3e1-5bfe-bdef-b4e5e5d283a9",
      "law_id": "3b27cebf-dad2-52bd-8fc1-2257d454c0f3",
      "source_version_id": "8add7820-2ef4-57cb-a025-284def2a62a9",
      "official_locator": "Article 32(1)",
      "label": "引用",
      "summary": "公表された著作物の引用について、公正な慣行と引用目的上正当な範囲などを定める。",
      "summary_language": "ja",
      "text_role": "original",
      "translation_of_anchor_id": null,
      "review_status": "proposed"
    },
    {
      "id": "93ba09b2-53d9-50a2-bf03-129ea9d36da5",
      "law_id": "3b27cebf-dad2-52bd-8fc1-2257d454c0f3",
      "source_version_id": "b92bb942-69fe-50ea-9be2-435084bd6747",
      "official_locator": "Article 15",
      "label": "職務上作成する著作物の著作者",
      "summary": "法人等が著作者となる条件を定める。プログラムについては別項の規定がある。",
      "summary_language": "ja",
      "text_role": "original",
      "translation_of_anchor_id": null,
      "review_status": "proposed"
    },
    {
      "id": "adb2a2d8-bf8e-568e-add9-0f3336e23af0",
      "law_id": "3b27cebf-dad2-52bd-8fc1-2257d454c0f3",
      "source_version_id": "c656352c-ea67-5d88-898d-5139ebf2468b",
      "official_locator": "Article 61",
      "label": "著作権の譲渡",
      "summary": "全部又は一部の譲渡と、第27条・第28条の権利が特掲されない場合の留保の推定を定める。",
      "summary_language": "ja",
      "text_role": "original",
      "translation_of_anchor_id": null,
      "review_status": "proposed"
    },
    {
      "id": "8f3414da-50b1-5269-8929-5b875d59b5ef",
      "law_id": "2289c703-7842-58d1-b898-876998b6116a",
      "source_version_id": "a58f02ea-b402-5837-91f4-f73076bc41f7",
      "official_locator": "Section 107",
      "label": "Fair use",
      "summary": "利用の目的・性格、著作物の性質、利用部分の量・重要性、市場等への影響を考慮する枠組み。",
      "summary_language": "ja",
      "text_role": "original",
      "translation_of_anchor_id": null,
      "review_status": "proposed"
    },
    {
      "id": "19a667e7-fdb2-506f-8a25-b5dca203302d",
      "law_id": "2289c703-7842-58d1-b898-876998b6116a",
      "source_version_id": "a58f02ea-b402-5837-91f4-f73076bc41f7",
      "official_locator": "Section 101: work made for hire",
      "label": "Work made for hire definition",
      "summary": "雇用の職務範囲での制作と、特定の委託類型及び署名書面による合意について定義する。",
      "summary_language": "ja",
      "text_role": "original",
      "translation_of_anchor_id": null,
      "review_status": "proposed"
    },
    {
      "id": "3f14a027-2ce3-564c-b8ac-89a8793c18c5",
      "law_id": "2289c703-7842-58d1-b898-876998b6116a",
      "source_version_id": "b3d6cf69-0f1d-5bd6-af38-06c6a2ffa72b",
      "official_locator": "Section 201(b)",
      "label": "Works made for hire ownership",
      "summary": "work made for hireに該当する場合の著作者・権利帰属と、署名書面による別段の合意を扱う。",
      "summary_language": "ja",
      "text_role": "original",
      "translation_of_anchor_id": null,
      "review_status": "proposed"
    },
    {
      "id": "f3db491d-3470-5ebb-b4f8-c60f25a633af",
      "law_id": "2289c703-7842-58d1-b898-876998b6116a",
      "source_version_id": "b3d6cf69-0f1d-5bd6-af38-06c6a2ffa72b",
      "official_locator": "Section 204(a)",
      "label": "Execution of copyright transfers",
      "summary": "法の作用による移転を除く著作権所有権の移転について、署名のある書面等の要件を定める。",
      "summary_language": "ja",
      "text_role": "original",
      "translation_of_anchor_id": null,
      "review_status": "proposed"
    }
  ],
  "issues": [
    {
      "id": "ef48cd61-f61b-5ad0-8bbf-6f503dfffba0",
      "key": "permission-exceptions",
      "label": "許諾なしの利用を検討する",
      "aliases": [
        "引用",
        "fair use",
        "フェアユース"
      ],
      "fact_questions": [
        "どの国で、何を、何の目的で、どれだけ利用するか。",
        "公表状況、表示方法、市場への影響などをどう確認するか。"
      ]
    },
    {
      "id": "11e5c8dd-b3e2-5310-b83f-5d509934090c",
      "key": "authorship",
      "label": "制作物の著作者を確認する",
      "aliases": [
        "職務著作",
        "work made for hire",
        "著作者"
      ],
      "fact_questions": [
        "実際の雇用・委託関係、制作の職務、契約の定めはどうなっているか。",
        "作品の種類、公表名義、署名書面の有無などを確認したか。"
      ]
    },
    {
      "id": "dc7c441f-70bd-5e30-b1de-059c655f4c4f",
      "key": "copyright-transfer",
      "label": "権利譲渡の範囲と形式を確認する",
      "aliases": [
        "著作権譲渡",
        "assignment",
        "権利譲渡"
      ],
      "fact_questions": [
        "譲渡する支分権、地域、期間、相手方、契約形式をどう定めたか。",
        "契約準拠法と、どの国の著作権を扱うかを区別したか。"
      ]
    }
  ],
  "comparisons": [
    {
      "id": "49ed398f-2fbb-53df-8da6-efff017b9b8d",
      "issue_id": "ef48cd61-f61b-5ad0-8bbf-6f503dfffba0",
