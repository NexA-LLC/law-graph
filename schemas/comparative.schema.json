{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/NexA-LLC/law-graph/schemas/comparative.schema.json",
  "title": "Cross-jurisdiction issue comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "jurisdictions",
    "laws",
    "sources",
    "source_versions",
    "anchors",
    "issues",
    "comparisons",
    "observations",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "law-graph.comparative.v0"
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "country_code",
          "level",
          "subdivision",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "level": {
            "enum": [
              "national",
              "federal",
              "state"
            ]
          },
          "subdivision": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "minItems": 0,
      "maxItems": 500
    },
    "laws": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "jurisdiction_id",
          "identifier_scheme",
          "official_id",
          "native_title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "jurisdiction_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "identifier_scheme": {
            "enum": [
              "egov-law-id",
              "uscode-title"
            ]
          },
          "official_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "native_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "minItems": 0,
      "maxItems": 500
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "jurisdiction_id",
          "provider",
          "document_key",
          "publisher",
          "url",
          "language",
          "text_role",
          "authority_kind",
          "reuse_mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "jurisdiction_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "document_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$"
          },
          "text_role": {
            "enum": [
              "original",
              "reference_translation"
            ]
          },
          "authority_kind": {
            "enum": [
              "official_api",
              "official_compilation",
              "reference"
            ]
          },
          "reuse_mode": {
            "const": "reference_and_project_summary_only"
          }
        }
      },
      "minItems": 0,
      "maxItems": 500
    },
    "source_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "content_sha256",
          "hash_method",
          "content_type",
          "byte_length",
          "upstream_revision_id",
          "version_label",
          "reported_through_date",
          "version_evidence_id",
          "original_bundled",
          "retrieval_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "hash_method": {
            "const": "raw-bytes-sha256-v1"
          },
          "content_type": {
            "enum": [
              "application/json",
              "text/html"
            ]
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1
          },
          "upstream_revision_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "version_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "reported_through_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "version_evidence_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "original_bundled": {
            "const": false
          },
          "retrieval_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      },
      "minItems": 0,
      "maxItems": 500
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "law_id",
          "source_version_id",
          "official_locator",
          "label",
          "summary",
          "summary_language",
          "text_role",
          "translation_of_anchor_id",
          "review_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "law_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "source_version_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "official_locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "summary_language": {
            "const": "ja"
          },
          "text_role": {
            "enum": [
              "original",
              "reference_translation"
            ]
          },
          "translation_of_anchor_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "review_status": {
            "const": "proposed"
          }
        }
      },
      "minItems": 0,
      "maxItems": 500
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "label",
          "aliases",
          "fact_questions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 0,
            "maxItems": 20
          },
          "fact_questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600
            },
            "minItems": 1,
            "maxItems": 12
          }
        }
      },
      "minItems": 0,
      "maxItems": 500
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "issue_id",
          "relation",
          "sides",
          "similarity_basis",
          "material_differences",
          "not_covered",
          "equivalence",
          "current_applicability",
          "review_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "issue_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "relation": {
            "const": "compares_issue"
          },
          "sides": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "jurisdiction_id",
                "primary_anchor_ids",
                "reference_anchor_ids"
              ],
              "properties": {
                "jurisdiction_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "primary_anchor_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true
                },
                "reference_anchor_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "minItems": 0,
                  "maxItems": 20
                }
              }
            },
            "minItems": 2,
            "maxItems": 2
          },
          "similarity_basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "material_differences": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600
            },
            "minItems": 1,
            "maxItems": 12
          },
          "not_covered": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600
            },
            "minItems": 1,
            "maxItems": 12
          },
          "equivalence": {
            "const": "not_asserted"
          },
          "current_applicability": {
            "const": "not_assessed"
          },
          "review_status": {
            "const": "proposed"
          }
        }
      },
      "minItems": 0,
      "maxItems": 500
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_version_id",
          "observed_at",
          "request_url"
        ],
        "properties": {
          "source_version_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      },
      "minItems": 1,
      "maxItems": 500
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observed_on",
          "jurisdiction_ids",
          "issue_ids",
          "status",
          "limitations"
        ],
        "properties": {
          "observed_on": {
            "type": "string",
            "format": "date"
          },
          "jurisdiction_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true
          },
          "issue_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true
          },
          "status": {
            "const": "partial"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1600
            },
            "minItems": 1,
            "maxItems": 12
          }
        }
      },
      "minItems": 1,
      "maxItems": 500
    }
  }
}
