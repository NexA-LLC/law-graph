{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/NexA-LLC/law-graph/schemas/cases.schema.json",
  "title": "Public case and issue graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topics",
    "issues",
    "cases",
    "claims",
    "sources",
    "source_versions",
    "evidence_refs",
    "relations",
    "reviews",
    "observations",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "law-graph.cases.v0"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "label",
          "aliases",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "aliases": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      },
      "maxItems": 50
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "label",
          "fact_questions",
          "scope_note",
          "review_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "fact_questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "maxItems": 12
          },
          "scope_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "review_status": {
            "const": "proposed"
          }
        }
      },
      "maxItems": 100
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "kind",
          "title",
          "jurisdiction",
          "forum",
          "event_date",
          "published_date",
          "docket_number",
          "later_history",
          "legal_context",
          "claim_ids",
          "scope_limits",
          "evidence_ref_ids",
          "review_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "enum": [
              "judgment",
              "administrative_action",
              "business_example"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "jurisdiction": {
            "const": "JP"
          },
          "forum": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "event_date": {
            "type": "string",
            "format": "date"
          },
          "published_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "docket_number": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "later_history": {
            "const": "not_checked"
          },
          "legal_context": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "role",
                "text_status"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "role": {
                  "const": "at_case_time"
                },
                "text_status": {
                  "const": "not_collected"
                }
              }
            }
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "uniqueItems": true,
            "maxItems": 12
          },
          "scope_limits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "evidence_ref_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "uniqueItems": true,
            "maxItems": 6
          },
          "review_status": {
            "const": "proposed"
          }
        }
      },
      "maxItems": 100
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "case_id",
          "kind",
          "text",
          "evidence_ref_ids",
          "authorship",
          "review_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "kind": {
            "enum": [
              "party_allegation",
              "reported_fact",
              "court_finding",
              "regulator_finding",
              "outcome",
              "curator_interpretation"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "evidence_ref_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "uniqueItems": true
          },
          "authorship": {
            "const": "ai_assisted_draft"
          },
          "review_status": {
            "const": "proposed"
          }
        }
      },
      "maxItems": 1000
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "document_key",
          "title",
          "publisher",
          "kind",
          "url",
          "upstream_ids",
          "reuse_mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "document_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "enum": [
              "judgment",
              "administrative_publication",
              "regulatory_guidance",
              "industry_guideline",
              "business_publication"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "upstream_ids": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "reuse_mode": {
            "const": "reference_and_project_summary_only"
          }
        }
      },
      "maxItems": 300
    },
    "source_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "content_sha256",
          "content_type",
          "byte_length",
          "original_bundled",
          "hash_method"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_type": {
            "enum": [
              "application/pdf",
              "text/html"
            ]
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1
          },
          "original_bundled": {
            "const": false
          },
          "hash_method": {
            "const": "raw-bytes-sha256-v1"
          }
        }
      },
      "maxItems": 600
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_version_id",
          "locator",
          "support_note",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "source_version_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "pages",
              "section"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "pdf_pages",
                  "html_section"
                ]
              },
              "pages": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "section": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          },
          "support_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "verification": {
            "const": "locator_recorded_original_not_bundled"
          }
        }
      },
      "maxItems": 2000
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "from_id",
          "to_id",
          "basis",
          "material_differences",
          "evidence_ref_ids",
          "review_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "type": {
            "enum": [
              "raises",
              "illustrated_by",
              "guidance_on"
            ]
          },
          "from_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "to_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "basis": {
            "const": "curated_association"
          },
          "material_differences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "evidence_ref_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "review_status": {
            "const": "proposed"
          }
        }
      },
      "maxItems": 1000
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject_id",
          "subject_sha256",
          "scope",
          "outcome",
          "reviewer",
          "review_url",
          "recorded_at",
          "reason",
          "supersedes_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "subject_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "subject_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "scope": {
            "enum": [
              "source_check",
              "legal_interpretation"
            ]
          },
          "outcome": {
            "enum": [
              "supported",
              "disputed",
              "withdrawn"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "review_url": {
            "type": "string",
            "pattern": "^https://github\\.com/NexA-LLC/law-graph/pull/[0-9]+(?:#.*)?$"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "supersedes_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "maxItems": 1000
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_version_id",
          "observed_at",
          "request_url"
        ],
        "properties": {
          "source_version_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      },
      "maxItems": 1000
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observed_on",
          "status",
          "topic_ids",
          "case_ids",
          "current_applicability",
          "limitations"
        ],
        "properties": {
          "observed_on": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "const": "partial"
          },
          "topic_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "uniqueItems": true
          },
          "case_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "uniqueItems": true
          },
          "current_applicability": {
            "const": "not_assessed"
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      },
      "maxItems": 100
    }
  }
}
